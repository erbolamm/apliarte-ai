{
  "name": "apliarte-ai",
  "displayName": "ApliArte AI — Chat de IA Local",
  "description": "Chat de IA local para VS Code. Corre modelos directo en tu máquina o conecta LM Studio/Ollama. Sin APIs externas, 100% privado, 0 coste.",
  "version": "0.9.7",
  "icon": "icon.png",
  "publisher": "apliarte",
  "author": {
    "name": "Javier Mateo (ApliArte)",
    "url": "https://github.com/erbolamm"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/erbolamm/apliarte-ai"
  },
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Chat",
    "Machine Learning",
    "Other"
  ],
  "keywords": [
    "apliarte-ai",
    "lmstudio",
    "ollama",
    "local-ai",
    "continue",
    "gemma",
    "ia-gratis",
    "español"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "apliarteAi",
          "title": "ApliArte AI",
          "icon": "media/icon-dark.svg"
        }
      ]
    },
    "views": {
      "apliarteAi": [
        {
          "type": "webview",
          "id": "apliarteAi.chatView",
          "name": "Chat",
          "icon": "$(comment-discussion)"
        },
        {
          "id": "apliarteAi.workspaceView",
          "name": "Workspace",
          "icon": "$(folder)"
        }
      ]
    },
    "commands": [
      {
        "command": "apliarteAi.setup",
        "title": "ApliArte AI: Configurar IA Local",
        "icon": "$(rocket)"
      },
      {
        "command": "apliarteAi.detectProviders",
        "title": "ApliArte AI: Detectar LM Studio / Ollama"
      },
      {
        "command": "apliarteAi.changePreset",
        "title": "ApliArte AI: Cambiar Preset"
      },
      {
        "command": "apliarteAi.sendFileToChat",
        "title": "ApliArte AI: Enviar archivo al chat",
        "icon": "$(file)"
      },
      {
        "command": "apliarteAi.sendSelectionToChat",
        "title": "ApliArte AI: Enviar selección al chat",
        "icon": "$(selection)"
      },
      {
        "command": "apliarteAi.sendSelectedFiles",
        "title": "ApliArte AI: Enviar archivos seleccionados al chat",
        "icon": "$(files)"
      },
      {
        "command": "apliarteAi.refreshWorkspace",
        "title": "Refrescar",
        "icon": "$(refresh)"
      },
      {
        "command": "apliarteAi.toggleFile",
        "title": "Seleccionar/Deseleccionar archivo"
      },
      {
        "command": "apliarteAi.action.explain",
        "title": "ApliArte AI: Explicar código"
      },
      {
        "command": "apliarteAi.action.refactor",
        "title": "ApliArte AI: Refactorizar"
      },
      {
        "command": "apliarteAi.action.bugs",
        "title": "ApliArte AI: Buscar bugs"
      },
      {
        "command": "apliarteAi.action.tests",
        "title": "ApliArte AI: Generar tests"
      },
      {
        "command": "apliarteAi.action.docs",
        "title": "ApliArte AI: Documentar"
      },
      {
        "command": "apliarteAi.action.optimize",
        "title": "ApliArte AI: Optimizar"
      },
      {
        "command": "apliarteAi.recommendModels",
        "title": "ApliArte AI: Recomendar modelos para mi equipo"
      },
      {
        "command": "apliarteAi.indexWorkspace",
        "title": "ApliArte AI: Indexar workspace (RAG)",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "apliarteAi.chooseModelsDir",
        "title": "ApliArte AI: Elegir carpeta de modelos",
        "icon": "$(folder-opened)"
      },
      {
        "command": "apliarteAi.restartMcpServer",
        "title": "ApliArte AI: Reiniciar servidor MCP",
        "icon": "$(refresh)"
      },
      {
        "command": "apliarteAi.showMcpStatus",
        "title": "ApliArte AI: Estado de servidores MCP",
        "icon": "$(pulse)"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "submenu": "apliarteAi.submenu",
          "group": "apliarteAi@1"
        }
      ],
      "apliarteAi.submenu": [
        {
          "command": "apliarteAi.sendSelectionToChat",
          "when": "editorHasSelection",
          "group": "send@1"
        },
        {
          "command": "apliarteAi.sendFileToChat",
          "group": "send@2"
        },
        {
          "command": "apliarteAi.action.explain",
          "when": "editorHasSelection",
          "group": "actions@1"
        },
        {
          "command": "apliarteAi.action.refactor",
          "when": "editorHasSelection",
          "group": "actions@2"
        },
        {
          "command": "apliarteAi.action.bugs",
          "when": "editorHasSelection",
          "group": "actions@3"
        },
        {
          "command": "apliarteAi.action.tests",
          "when": "editorHasSelection",
          "group": "actions@4"
        },
        {
          "command": "apliarteAi.action.docs",
          "when": "editorHasSelection",
          "group": "actions@5"
        },
        {
          "command": "apliarteAi.action.optimize",
          "when": "editorHasSelection",
          "group": "actions@6"
        }
      ],
      "view/title": [
        {
          "command": "apliarteAi.refreshWorkspace",
          "when": "view == apliarteAi.workspaceView",
          "group": "navigation"
        },
        {
          "command": "apliarteAi.sendSelectedFiles",
          "when": "view == apliarteAi.workspaceView",
          "group": "navigation"
        }
      ]
    },
    "submenus": [
      {
        "id": "apliarteAi.submenu",
        "label": "ApliArte AI"
      }
    ],
    "keybindings": [
      {
        "command": "apliarteAi.sendSelectionToChat",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "apliarteAi.action.explain",
        "key": "ctrl+shift+e",
        "mac": "cmd+shift+e",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "configuration": {
      "title": "ApliArte AI",
      "properties": {
        "apliarteAi.preset": {
          "type": "string",
          "default": "minimal",
          "enum": [
            "minimal",
            "ecosystem-only",
            "full-gentleman"
          ],
          "enumDescriptions": [
            "Lite — System prompt compacto (~5k tokens). Ideal para modelos ≤ 8B.",
            "Medium — System prompt extendido (~20k tokens). Para modelos 13B-30B.",
            "Full — System prompt completo (~49k tokens). Para modelos grandes o APIs en la nube."
          ],
          "description": "Nivel de detalle del system prompt. A más tokens, mejor comportamiento pero más lento en modelos pequeños."
        },
        "apliarteAi.modelsDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "Carpeta donde se guardan los modelos de IA locales (ONNX y GGUF). Vacío = almacenamiento interno de la extensión. Puedes apuntar a un disco externo, tarjeta SD o cualquier ruta. Ejemplo: `/Volumes/STAGING/ia`"
        },
        "apliarteAi.lmstudioEndpoint": {
          "type": "string",
          "default": "http://localhost:1234/v1",
          "markdownDescription": "URL base del servidor LM Studio. Por defecto `http://localhost:1234/v1`. Cámbialo si usas un puerto personalizado o un servidor remoto."
        },
        "apliarteAi.ollamaEndpoint": {
          "type": "string",
          "default": "http://localhost:11434",
          "markdownDescription": "URL base del servidor Ollama. Por defecto `http://localhost:11434`. No incluyas `/v1` — la extensión lo añade automáticamente."
        },
        "apliarteAi.language": {
          "type": "string",
          "default": "es",
          "enum": [
            "es",
            "en"
          ],
          "enumDescriptions": [
            "Español",
            "English"
          ],
          "description": "Idioma de la interfaz del chat. Cambia al instante sin reiniciar."
        },
        "apliarteAi.agentEndpoint": {
          "type": "string",
          "default": "",
          "markdownDescription": "URL de tu servidor de agente remoto. Ejemplo: `https://mi-servidor.com`. Déjalo vacío para desactivar el modo Agente. Consulta la guía del repositorio para desplegar tu propio backend."
        },
        "apliarteAi.agentApiKey": {
          "type": "string",
          "default": "",
          "description": "API key del servidor de agente remoto. Se guarda en la configuración global de VS Code."
        },
        "apliarteAi.huggingfaceToken": {
          "type": "string",
          "default": "",
          "markdownDescription": "Token de HuggingFace para descargar modelos privados o con acceso restringido (gated). Consíguelo en [huggingface.co/settings/tokens](https://huggingface.co/settings/tokens). Solo necesario si ves error 'Unauthorized' al descargar un modelo."
        },
        "apliarteAi.inlineCompletion": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Activa el autocompletado inline (Tab) en el editor. Solo funciona en modo **Remote** (LM Studio / Ollama) con modelos que soporten FIM como Qwen2.5-Coder. Desactivado por defecto."
        },
        "apliarteAi.mcpServers": {
          "type": "object",
          "default": {},
          "markdownDescription": "Servidores MCP conectados. Cada clave es el nombre del servidor y el valor define su transporte.\n\n**Ejemplo stdio:**\n```json\n{\n  \"filesystem\": {\n    \"transport\": \"stdio\",\n    \"command\": \"npx\",\n    \"args\": [\"-y\", \"@modelcontextprotocol/server-filesystem\", \"/ruta/carpeta\"]\n  }\n}\n```\n\n**Ejemplo HTTP:**\n```json\n{\n  \"mi-servidor\": {\n    \"transport\": \"http\",\n    \"url\": \"http://localhost:8080/mcp\"\n  }\n}\n```",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "transport": {
                "type": "string",
                "enum": [
                  "stdio",
                  "http"
                ]
              },
              "command": {
                "type": "string",
                "description": "Ejecutable (solo transport stdio)"
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Argumentos (solo stdio)"
              },
              "env": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Variables de entorno (solo stdio)"
              },
              "cwd": {
                "type": "string",
                "description": "Directorio de trabajo (solo stdio)"
              },
              "url": {
                "type": "string",
                "description": "URL del servidor (solo transport http)"
              },
              "headers": {
                "type": "object",
                "additionalProperties": {
                  "type": "string"
                },
                "description": "Headers HTTP (solo http)"
              }
            },
            "required": [
              "transport"
            ]
          }
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.js --production",
    "watch": "node esbuild.js --watch",
    "lint": "tsc --noEmit",
    "test": "TSX_TSCONFIG_PATH=tsconfig.test.json node --import tsx --test test/**/*.test.ts",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.39",
    "@types/vscode": "^1.93.0",
    "@vscode/codicons": "^0.0.45",
    "esbuild": "^0.21.0",
    "tsx": "^4.21.0",
    "typescript": "^5.5.0"
  }
}
